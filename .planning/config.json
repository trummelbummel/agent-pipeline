{
  "version": 1,
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "workflow": {
    "use_worktrees": false,
    "auto_advance": true,
    "_auto_chain_active": true
  },
  "context_window": 200000,
  "git": {
    "branching_strategy": "none",
    "allow_default_branch_commits": true
  }
}